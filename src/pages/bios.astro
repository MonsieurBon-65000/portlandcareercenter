---
import Layout from "../layouts/Layout.astro";
import { team } from "../data/team";
---

<Layout title="Our Team">
  <h1 class="text-3xl font-semibold tracking-tight mb-3">Our Team</h1>
  <p class="prose text-[var(--color-muted-foreground)] max-w-none mb-10">
    Portland Career Center is a team of career counselors and coaches in private practice in
    Portland, Oregon, bringing well over a hundred combined years of guiding adults toward
    meaningful, sustainable work. Each of us has completed graduate training — Master's degrees
    in Counseling, Education, or Training &amp; Development — and several are licensed (LPC).
    Get to know us below, then reach out to whoever feels like the right fit.
  </p>

  <div class="space-y-10">
    {
      team.map((m) => (
        <article class="flex flex-col sm:flex-row gap-5 border-b border-[var(--color-border)] pb-10 last:border-0">
          <img
            src={m.photo}
            alt={m.name}
            width="112"
            height="112"
            class="h-28 w-28 rounded-full object-cover border border-[var(--color-border)] shrink-0"
          />
          <div>
            <h2 class="text-xl font-semibold tracking-tight">
              {m.name}
              <span class="text-base font-normal text-[var(--color-muted-foreground)]">
                , {m.credentials}
              </span>
            </h2>
            {m.practice && <p class="text-sm font-medium text-[var(--color-accent)] mt-0.5">{m.practice}</p>}
            {m.note && (
              <p class="mt-1 inline-block rounded-full bg-[var(--color-muted)] px-2.5 py-0.5 text-xs text-[var(--color-muted-foreground)]">
                {m.note}
              </p>
            )}
            <p class="mt-3 leading-relaxed">{m.bio}</p>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
              {m.websiteUrl && (
                <a href={m.websiteUrl} class="text-[var(--color-accent)] underline underline-offset-2">
                  {m.website}
                </a>
              )}
              {m.email && (
                <a href={`mailto:${m.email}`} class="text-[var(--color-accent)] underline underline-offset-2">
                  {m.email}
                </a>
              )}
              {m.phone && <span class="text-[var(--color-muted-foreground)]">{m.phone}</span>}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Layout>
