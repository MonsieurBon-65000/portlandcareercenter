---
import Layout from "../layouts/Layout.astro";
import { team } from "../data/team";
---

<Layout>
  <section class="text-center py-8">
    <p class="text-sm font-medium uppercase tracking-wide text-[var(--color-accent)]">
      Portland, Oregon
    </p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">
      Portland Career Center
    </h1>
    <p class="mt-5 text-lg text-[var(--color-muted-foreground)] max-w-xl mx-auto leading-relaxed">
      A team of experienced career counselors helping people navigate career
      transition, job search, and meaningful work — with over a hundred combined
      years of guiding adults toward careers that fit.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a
        href="/blog"
        class="rounded-md bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-[var(--color-accent-foreground)] hover:opacity-90 transition"
      >
        Read our articles
      </a>
      <a
        href="/bios"
        class="rounded-md border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium hover:border-[var(--color-accent)] transition"
      >
        Meet the team
      </a>
    </div>
  </section>

  <section class="mt-12 border-t border-[var(--color-border)] pt-10">
    <h2 class="text-xl font-semibold tracking-tight">Our counselors</h2>
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-6">
      {
        team.map((m) => (
          <div class="text-center">
            <img
              src={m.photo}
              alt={m.name}
              width="96"
              height="96"
              class="mx-auto h-24 w-24 rounded-full object-cover border border-[var(--color-border)]"
            />
            <p class="mt-3 text-sm font-medium leading-snug">
              {m.name}, {m.credentials}
            </p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-[var(--color-muted-foreground)]">
      <a href="/bios" class="text-[var(--color-accent)] underline underline-offset-2">
        See full bios →
      </a>
    </p>
  </section>
</Layout>
