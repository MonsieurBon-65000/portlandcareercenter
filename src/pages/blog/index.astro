---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title="Articles">
  <h1 class="text-3xl font-semibold tracking-tight mb-2">Articles</h1>
  <p class="text-[var(--color-muted-foreground)] mb-8">
    Career transition, job search, and professional growth — from our team of counselors.
  </p>

  <ul class="divide-y divide-[var(--color-border)]">
    {
      posts.map((post) => (
        <li class="py-4">
          <a href={`/blog/${post.id}`} class="group block">
            <h2 class="text-lg font-medium group-hover:text-[var(--color-accent)] transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-[var(--color-muted-foreground)] mt-1">
              {fmt(post.data.date)}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
