---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { topicsFor } from "../../lib/topics";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const topics = topicsFor(post.data.categories);
---

<Layout title={post.data.title}>
  <article>
    <a href="/blog" class="text-sm text-[var(--color-accent)] underline underline-offset-2">
      ← All articles
    </a>

    {/* Topic section at the top of the article */}
    {
      topics.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {topics.map((t) => (
            <a
              href={`/topics/${t.slug}`}
              class="rounded-full bg-[var(--color-accent-soft)] px-3 py-1 text-xs font-medium text-[var(--color-accent)] hover:opacity-80 transition"
            >
              {t.label}
            </a>
          ))}
        </div>
      )
    }

    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{post.data.title}</h1>
    <div class="prose mt-8">
      <Content />
    </div>
    <div class="clear-both"></div>
  </article>
</Layout>
