---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { topicsFor, allTopics } from "../../lib/topics";

const posts = await getCollection("blog");
const counts = new Map<string, number>();
for (const p of posts) for (const t of topicsFor(p.data.categories)) {
  counts.set(t.slug, (counts.get(t.slug) ?? 0) + 1);
}
const topics = allTopics().filter((t) => counts.get(t.slug)); // only topics with posts
---

<Layout title="Topics">
  <h1 class="text-3xl font-semibold tracking-tight mb-2">Browse by Topic</h1>
  <p class="text-[var(--color-muted-foreground)] mb-8">
    Find articles on the part of your career journey you're working through.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {
      topics.map((t) => (
        <a
          href={`/topics/${t.slug}`}
          class="flex items-center justify-between rounded-lg border border-[var(--color-border)] px-4 py-3 hover:border-[var(--color-accent)] transition"
        >
          <span class="font-medium">{t.label}</span>
          <span class="text-sm text-[var(--color-muted-foreground)]">{counts.get(t.slug)}</span>
        </a>
      ))
    }
  </div>
</Layout>
