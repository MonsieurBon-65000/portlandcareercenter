---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <article>
    <h1 class="text-3xl font-semibold tracking-tight mb-6">{frontmatter.title}</h1>
    <div class="prose">
      <slot />
    </div>
    <div class="clear-both"></div>
  </article>
</Layout>
